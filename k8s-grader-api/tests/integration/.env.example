# Integration Test Configuration
# Copy this file to .env and fill in your values

# Required: CloudFormation stack name
STACK_NAME=k8s-grader-api-dev

# Required: Encrypted API key (contains user email)
# Generate using the keygen endpoint (keys are persistent and reused):
# 1. Run: ./generate_test_api_key.sh
# 2. Visit the generated URL in your browser
# 3. Copy the encrypted key and paste it here
#
# Note: The keygen endpoint checks DynamoDB first and returns the existing key
# if one already exists for your email. Keys are NOT regenerated on each call.
TEST_API_KEY=your-encrypted-api-key-here

# Optional: AWS region (default: us-east-1)
AWS_REGION=us-east-1

# Optional: Test user email (default: integration-test@example.com)
# This should match the email used to generate the API key
TEST_EMAIL=integration-test@example.com
